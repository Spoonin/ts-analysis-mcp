{
  "name": "ts-analysis-mcp",
  "version": "0.3.0",
  "description": "MCP server for structural navigation of TypeScript / React / NestJS codebases via ts-morph",
  "type": "module",
  "license": "MIT",
  "author": "Denis Lozhkin <lozhkindenis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spoonin/ts-analysis-mcp.git"
  },
  "homepage": "https://github.com/Spoonin/ts-analysis-mcp#readme",
  "bugs": {
    "url": "https://github.com/Spoonin/ts-analysis-mcp/issues"
  },
  "keywords": [
    "mcp",
    "typescript",
    "nestjs",
    "react",
    "jsx",
    "component-tree",
    "hooks",
    "redux",
    "state-management",
    "ts-morph",
    "code-analysis",
    "navigation",
    "decorators",
    "ai-agent",
    "model-context-protocol"
  ],
  "bin": {
    "ts-analysis-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ts-morph": "^23.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
